Screen {
    layout: vertical;
}

#search_row {
    height: auto;
    padding: 1 2;
    align: center middle;
}

#search_label {
    width: auto;
    height: 3;
    content-align: left middle;
    margin-right: 1;
}

#search_input {
    width: 1fr;
}

#main_body {
    width: 1fr;
    height: 1fr;
    padding: 0 1 1 1;
}

#results_block, #details_block {
    height: 1fr;
    border: round $primary;
    padding: 1;
}

#results_block {
    width: 3fr;
}

#details_block {
    width: 1fr;
}
